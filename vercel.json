{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://meeting-summarizer-0we1.onrender.com/api/$1"
    },
    {
      "src": "/static/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/static/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
