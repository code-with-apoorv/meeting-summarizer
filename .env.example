# ==========================================
# Meeting Summarizer Environment Variables
# ==========================================

# Groq API Key (Fastest Whisper ASR & Llama-3.3 LLM - Recommended)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key (Whisper-1 & GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API Key (Gemini 1.5 Flash Audio & LLM)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Engine Selection: "auto", "groq", "openai", "gemini", or "mock"
DEFAULT_ASR_PROVIDER=auto
DEFAULT_LLM_PROVIDER=auto

# Server Configuration
PORT=8000
HOST=0.0.0.0
